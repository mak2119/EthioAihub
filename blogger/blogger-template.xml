     * ------------------------------------------------------------- */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      overflow: hidden !important;
      background: #f8fafc;
    }
    
    #header, .header-outer, #footer, .footer-outer, 
    .sidebar-container, .blog-pager, .post-feeds, 
    .feed-links, .post-footer, .comments, #navbar, 
    .widget.Header, .widget.Navbar, .widget.BlogArchive,
    .widget.PopularPosts, .Attribution, .status-msg-wrap,
    .sidebar, .main-inner, .widget, .blog-posts {
      display: none !important;
      visibility: hidden !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #app-container {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      z-index: 999999;
    }
  ]]></b:skin>

