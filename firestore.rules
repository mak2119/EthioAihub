rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email in ['admin@ethioai.et', 'tadeapps@gmail.com']);
    }

    // User Profiles:
    // Users can read and update their own name/language, but CANNOT modify their plan or subscriptionStatus
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.plan == 'free';
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus', 'role', 'isAdmin']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Payment Requests (TeleBirr):
    // Users can submit their payment request; only Admins can approve/update status
    match /paymentRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // User Private Financial & Equb Records:
    // Strictly isolated: account owner ONLY
    match /financialRecords/{recordId} {
      allow read, write: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // User Saved Items (Chats, Documents, Properties):
    match /savedItems/{itemId} {
      allow read, write: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Ethio Academy Courses:
    // Published courses can be read by authenticated users; created/edited by Admin only
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Course Enrollments & Progress:
    match /userCourses/{enrollId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Real Estate Property Listings:
    // Anyone can read approved listings; users can submit pending listings; Admin approves
    match /propertyListings/{listingId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (isAuthenticated() && resource.data.submittedBy == request.auth.token.email);
      allow create: if isAuthenticated() && request.resource.data.status == 'pending_moderation';
      allow update, delete: if isAdmin();
    }

    // Suspicious Broker Reports:
    // Submitted by users; viewable and manageable by Admin only
    match /brokerReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Transaction Verifications:
    match /transactionVerifications/{verId} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    // System Settings (e.g. TeleBirr receiver phone number):
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
